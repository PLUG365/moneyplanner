rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── ヘルパー関数 ──
    function signedIn() {
      return request.auth != null;
    }

    // 現在のユーザーが所属する世帯IDを取得
    function userHouseholdId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    function notRemoved(memberData) {
      return !("removedAt" in memberData) || memberData.removedAt == null;
    }

    function activeMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && userHouseholdId() == householdId
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid))
        && notRemoved(get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data);
    }

    // 作成バッチの get() はコミット前状態を参照する。これにより、既存の
    // active member が users.householdId を同一バッチで差し替えて別世帯を
    // 作成する競合を fail-closed にする。
    function requesterHasActiveMembership() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'householdId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId is string
        && exists(/databases/$(database)/documents/households/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId))
        && exists(/databases/$(database)/documents/households/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId)/members/$(request.auth.uid))
        && notRemoved(get(/databases/$(database)/documents/households/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId)/members/$(request.auth.uid)).data);
    }

    // join request の作成/申請者本人による pending 更新では、同一バッチ内で
    // 新世帯への所属を成立させた場合も拒否するためコミット後状態を評価する。
    function requesterHasActiveMembershipAfter() {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'householdId' in getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId is string
        && existsAfter(/databases/$(database)/documents/households/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId))
        && existsAfter(/databases/$(database)/documents/households/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId)/members/$(request.auth.uid))
        && notRemoved(getAfter(/databases/$(database)/documents/households/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId)/members/$(request.auth.uid)).data);
    }

    function createsOwnHouseholdInvite(householdId) {
      return existsAfter(/databases/$(database)/documents/households/$(householdId))
        && getAfter(/databases/$(database)/documents/households/$(householdId)).data.createdBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid))
        && notRemoved(getAfter(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data);
    }

    function inviteCodeUsableForHousehold(code, householdId) {
      return code is string
        && exists(/databases/$(database)/documents/inviteCodes/$(code))
        && get(/databases/$(database)/documents/inviteCodes/$(code)).data.householdId == householdId
        && (!('disabledAt' in get(/databases/$(database)/documents/inviteCodes/$(code)).data)
          || get(/databases/$(database)/documents/inviteCodes/$(code)).data.disabledAt == null)
        && (!('expiresAt' in get(/databases/$(database)/documents/inviteCodes/$(code)).data)
          || get(/databases/$(database)/documents/inviteCodes/$(code)).data.expiresAt > request.time);
    }

    // ユーザードキュメント: 本人のみ読み書き可
    match /users/{userId} {
      allow read, create: if signedIn() && request.auth.uid == userId;
      // active member はプロフィールを更新できるが、所属世帯IDを先に消去・
      // 差し替えてから別世帯を作成・参加する逐次迂回は許可しない。
      allow update: if signedIn()
        && request.auth.uid == userId
        && (
          !requesterHasActiveMembership()
          || (
            'householdId' in request.resource.data
            && request.resource.data.householdId == resource.data.householdId
          )
        );
      // active member のプロフィール単独削除は世帯データを孤児化するため拒否する。
      allow delete: if signedIn()
        && request.auth.uid == userId
        && !requesterHasActiveMembership();
    }

    // 招待コード: コードを知っている認証済みユーザーのみ直接参照する。
    // 一覧取得は総当たり対策で原則禁止だが、自世帯のコードに限り許可する
    // （世帯退出・全データ削除時のクリーンアップで householdId 一致検索が必要。
    // activeMember は members サブコレクションを根拠にするため、自分の users.householdId を
    // 書き換えただけの非メンバーには一覧できず、総当たり耐性は維持される）。
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && activeMember(resource.data.householdId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.householdId is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.disabledAt == null
        && (
          activeMember(request.resource.data.householdId)
          || createsOwnHouseholdInvite(request.resource.data.householdId)
        );
      // 更新は無効化(disabledAt)等のみ想定。世帯紐付け・発行者・有効期限は改変不可。
      allow update: if signedIn()
        && activeMember(resource.data.householdId)
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.expiresAt == resource.data.expiresAt;
      allow delete: if signedIn()
        && activeMember(resource.data.householdId);
    }

    // 世帯ドキュメント: 自世帯メンバーのみアクセス可
    // 世帯メンバーは全員対等（オーナー/管理者ロールなし）。createdBy は作成記録であり権限には使わない。
    match /households/{householdId} {
      allow create: if signedIn()
        && !requesterHasActiveMembership()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.inviteCode is string;
      allow read, delete: if activeMember(householdId);
      // createdBy は作成後変更不可
      allow update: if activeMember(householdId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.inviteCode is string;

      match /members/{userId} {
        allow read: if activeMember(householdId);
        allow create: if signedIn()
          && (
            activeMember(householdId)
            || (
              // 世帯作成バッチでの自己登録のみ許可。
              // 既存世帯への参加は承認者（activeMember）が作成する。
              request.auth.uid == userId
              && getAfter(/databases/$(database)/documents/households/$(householdId)).data.createdBy == request.auth.uid
              && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == householdId
            )
          );
        allow update: if activeMember(householdId);
        allow delete: if activeMember(householdId);
      }

      match /joinRequests/{userId} {
        allow read: if activeMember(householdId)
          || (signedIn() && request.auth.uid == userId);

        allow create: if signedIn()
          && !requesterHasActiveMembership()
          && !requesterHasActiveMembershipAfter()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.status == "pending"
          && request.resource.data.inviteCode is string
          && inviteCodeUsableForHousehold(request.resource.data.inviteCode, householdId)
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 20;

        allow update: if (
            signedIn()
            && !requesterHasActiveMembership()
            && !requesterHasActiveMembershipAfter()
            && request.auth.uid == userId
            && request.resource.data.uid == userId
            && request.resource.data.status == "pending"
            && request.resource.data.inviteCode is string
            && inviteCodeUsableForHousehold(request.resource.data.inviteCode, householdId)
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 20
          )
          || (
            activeMember(householdId)
            && request.auth.uid != userId
            // 承認/却下は状態更新のみ。申請者uidの改変は不可
            && request.resource.data.uid == resource.data.uid
          );

        allow delete: if activeMember(householdId)
          || (
            signedIn()
            && request.auth.uid == userId
            && (resource.data.status == "pending" || resource.data.status == "rejected")
          );
      }

      // 世帯配下の実データサブコレクション: 自世帯メンバーのみ。
      // joinRequests / members は専用の厳格ルールで統治するため、
      // ここでの一律 write 許可の対象から除外する（uid 不変等の制約を効かせるため）。
      match /{subcollection}/{docId} {
        allow read, write: if activeMember(householdId)
          && subcollection != "joinRequests"
          && subcollection != "members";
      }
    }
  }
}
